# Copy to .env and fill in. Client vars are inlined into the browser bundle;
# everything else is server-only (set in Vercel > Settings > Environment Variables)
# and must never use the REACT_APP_ prefix.

# ---- Client (browser bundle) ----------------------------------------------
# NOTE: any new REACT_APP_* var must also be added to the allowlist in
# vite.config.mjs (the `define` block) or it will be undefined in the browser.
REACT_APP_BASE_URL=https://your-api-id.execute-api.eu-west-1.amazonaws.com
REACT_APP_DATE=
REACT_APP_FRONTEND_URL=

# ---- Auth (api/_lib/auth.js) ----------------------------------------------
# API base used to verify the caller's token (falls back to REACT_APP_BASE_URL).
BACKEND_API_URL=
# Admin-only GET path used to confirm the caller is an admin. Default: /api/super/admin/admins
AUTH_VERIFY_PATH=
# Any-authenticated-user GET path used to verify allowlisted callers. Default: /api/departments
USER_VERIFY_PATH=
# Extra login codes granted bulk email access, comma-separated.
# Default: "tolutrain,ayo,rhinoceros25@". Keep in sync with src/utils/bulkEmailAccess.js.
BULK_EMAIL_ALLOWLIST=

# ---- Email (api/send-bulk-email.js) ---------------------------------------
# Verified sender. Include a display name, e.g. "Name <no-reply@example.com>".
EMAIL_FROM=
# Display name used when EMAIL_FROM is a bare address.
EMAIL_FROM_NAME=
# Default provider when the request omits one: resend | brevo | zoho
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
# Zoho SMTP (both USER and PASS are required to send via Zoho)
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
# Defaults to smtp.zoho.com (smtp.zoho.eu, smtp.zoho.in, smtp.zoho.com.au)
ZOHO_SMTP_HOST=

# ---- S3 image upload (api/upload-email-image.js) --------------------------
# Bucket must allow public read.
AWS_S3_BUCKET=
# Default: eu-west-1
AWS_S3_REGION=
# Use these names, not AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (Vercel reserves them).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Supabase (api/_lib/supabase.js) --------------------------------------
SUPABASE_URL=
# Service role key: server-only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Webhooks --------------------------------------------------------------
# Shared secret for api/email-webhook.js. Provider URL:
# https://<host>/api/email-webhook?token=YOUR_SECRET  (or x-webhook-secret header)
EMAIL_WEBHOOK_SECRET=
# Shared secret for api/sms-webhook.js. Provider URL:
# https://<host>/api/sms-webhook?token=YOUR_SECRET  (or x-webhook-secret header)
SMS_WEBHOOK_SECRET=

# ---- SMS (api/send-bulk-sms.js, api/sms-balance.js) -----------------------
# Sendchamp live API key (sendchamp_live_...). Required; there is no fallback.
SENDCHAMP_API_KEY=
# SmartSMSSolutions API token (https://app.smartsmssolutions.com/developer/api)
SMARTSMS_API_TOKEN=

# ---- Limits ----------------------------------------------------------------
# Max recipients per bulk email/SMS request. Default: 2000
MAX_BULK_RECIPIENTS=
